# Flask Secret Key - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Login credentials
SUPERADMIN_PASSWORD=
ADMIN_PASSWORD=
USER_PASSWORD=

# TCS iON API
TCS_ION_API_URL=
USE_LOCAL_DATA=false

# SMTP
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_TIMEOUT=30

# Concurrent SMTP connections. This is the limit that actually bites: Office 365
# allows 3 per mailbox and answers 432 4.3.2 "Concurrent connections limit exceeded"
# above it. Do not raise without testing.
EMAIL_WORKERS=3

# Explicit messages/minute throttle; 0 = off, which is the default.
# Microsoft documents 30/min for SMTP AUTH submission, but this tenant was observed
# sustaining 660/min with zero rate refusals — the 3-connection ceiling above is what
# paces sending. Set a positive value only if 4.4.x / 4.7.x throttling appears.
SMTP_RATE_PER_MIN=0

# Retry policy for transient failures (4xx, dropped connections, timeouts).
# Bad addresses and 5xx rejections are never retried — they are logged instead.
SMTP_MAX_ATTEMPTS=5
SMTP_BACKOFF_BASE=2.0
SMTP_BACKOFF_CAP=60

# Backoff used specifically when the server reports a RATE limit. Rate limits are
# assessed over a rolling minute, so exponential backoff (2+4+8+16s) would expire
# inside the throttle window and lose the message. This waits the window out, and
# pauses every other sender at the same time. Keep it above 60.
SMTP_RATE_COOLDOWN=75

# Congratulate users by email when an API sync detects they completed an assigned
# course. Each (assignment, user) is emailed at most once. Set to false to disable.
NOTIFY_ON_COMPLETION=true

# Set to true only when running behind HTTPS
HTTPS_ONLY=false

# logs/app.log retention. It holds the per-recipient delivery record, so these bound
# how far back an individual send can be traced (the email_jobs table keeps the
# per-job summary indefinitely).
LOG_MAX_BYTES=5000000
LOG_BACKUPS=10
