# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/

# Node — Tailwind BUILD tooling only. Note that the compiled output it produces,
# static/css/tailwind.min.css, IS required at runtime and stays tracked.
node_modules/
package-lock.json
package.json

# Environment
.env

# Logs — auto-created by app.py (os.makedirs('logs', exist_ok=True))
logs/

# Data / runtime — nothing here is versioned.
#   * SQLite (data/app.db) is the source of truth; it and its WAL sidecars are
#     runtime state, and a copied -wal/-shm pair corrupts the DB.
#   * The legacy *.json migration seeds contain real user PII (names, emails).
#   * A tracked seed also makes `git clone` silently bootstrap a fresh app.db from
#     stale data, which is never what a new deployment wants.
# The directory itself is auto-created by app.py, so nothing needs to be committed.
data/

# Editor / IDE
.vscode/
.kiro/

# Windows-only launchers — hardcoded paths; production is Linux + systemd + gunicorn
deploy_setup.ps1
deploy_simple.bat
